<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.11</version> 
    <relativePath/>
</parent>

  <groupId>com.mycompany.app</groupId>
  <artifactId>SpringMicroService</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>SmallBooks — Plataforma de Biblioteca Digital</name>
  <packaging>pom</packaging>

  <!-- ============================================================ -->
  <!-- MÓDULOS DEL PROYECTO                                         -->
  <!-- Cada módulo es un microservicio independiente.               -->
  <!-- Orden recomendado de arranque:                               -->
  <!--   1. microservice-config  :8888                              -->
  <!--   2. microservice-eureka  :8761                              -->
  <!--   3. identity-services    :8084                              -->
  <!--   4. microservice-gateway :8080                              -->
  <!-- ============================================================ -->
  <modules>
    <module>microservice-config</module>
    <module>microservice-eureka</module>
    <module>microservice-gateway</module>
    <module>identity-services</module>
    <module>catalog-service</module>
    <module>license-service</module>
    <module>elending-service</module>      
    <module>ingestion-service</module>     
    <module>content-service</module> 
    <module>notification-service</module>  
    <module>subscription-service</module>  
    <module>search-service</module>        
    <module>analytics-service</module>     
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- BOM de Spring Cloud compatible con Spring Boot 3.1.x -->
    <spring-cloud.version>2023.0.5</spring-cloud.version>
  </properties>

  
  <!-- DEPENDENCIAS GLOBALES                                        -->
  <!-- Todo modulo hijo hereda estas dependencias automáticamente   -->
 
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.38</version>
      <optional>true</optional>
    </dependency>
    <dependency> <!-- Documentacion automatica con OpenAPI/Swagger en todos los microservicios -->
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>2.5.0</version>
    </dependency>
    <dependency> <!-- HATEOAS en todos los microservicios -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-hateoas</artifactId>
    </dependency>

    <!-- ============================================================ -->
    <!-- TRACING DISTRIBUIDO — Micrometer Tracing + Brave             -->
    <!-- ============================================================ -->
    <!-- Bridge Brave: genera traceId/spanId, los inyecta en MDC y   -->
    <!-- propaga headers B3/traceparent a traves de Feign y RabbitMQ -->
    <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-tracing-bridge-brave</artifactId>
    </dependency>
    <!-- Actuator: expone /actuator/health, metrics, info, etc.      -->
    <!-- Necesario para que Micrometer Tracing registre sus beans    -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- AOP: necesario para que @Observed funcione con ObservedAspect -->
    <!-- Permite crear spans manuales con anotaciones en métodos      -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- Zipkin Reporter: exporta trazas a Zipkin para visualización  -->
    <dependency>
        <groupId>io.zipkin.reporter2</groupId>
        <artifactId>zipkin-reporter-brave</artifactId>
    </dependency>
    <!-- Micrometer Observation Test: TestObservationRegistry para validar spans -->
    <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-observation-test</artifactId>
        <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>3.1.5</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
            <annotationProcessorPaths>
            <path>
          <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- NUEVO: plugins que se ejecutan en todos los módulos -->
    <plugins>
        <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.11</version>
            <executions>
                <execution>
                    <goals>
                        <goal>prepare-agent</goal>
                    </goals>
                </execution>
                <execution>
                    <id>report</id>
                    <phase>test</phase>
                    <goals>
                        <goal>report</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>
    </plugins>
  </build>

</project>